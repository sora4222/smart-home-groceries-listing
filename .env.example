# PostgreSQL
POSTGRES_DB=grocery
POSTGRES_USER=grocery
POSTGRES_PASSWORD=changeme
# Host port Compose publishes Postgres on; the tests connect here. Change it
# if another Postgres already uses 5432 on this machine.
POSTGRES_PORT=5432
# Containers always reach the database on db:5432, whatever POSTGRES_PORT is.
# Note: a plain postgres:// URL — sqlx takes no driver suffix, unlike
# SQLAlchemy's postgresql+asyncpg://
DATABASE_URL=postgres://grocery:changeme@db:5432/grocery
DATABASE_MAX_CONNECTIONS=10

# Address the backend binds to inside its container
BIND_ADDRESS=0.0.0.0:8000

# Clerk
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Clerk JWKS endpoint, from your Clerk instance's API settings
CLERK_JWKS_URL=

# Generic intake webhook shared secret — Home Assistant, IFTTT, curl, tests
# (generate: openssl rand -hex 32)
VOICE_WEBHOOK_SECRET=

# Alexa
# Your skill id from the Alexa developer console (amzn1.ask.skill.<uuid>).
# The bridge verifies every request against it.
ALEXA_SKILL_ID=
# Secret the Alexa bridge sidecar authenticates to the backend with. Keep it
# DIFFERENT from VOICE_WEBHOOK_SECRET, so leaking one does not grant the other.
# (generate: openssl rand -hex 32)
ALEXA_BRIDGE_SECRET=

# "Fill Woolworths trolley" bookmarklet secret (docs/FEAT_WOOLWORTHS_ACCESS.md).
# The bookmarklet sends it from woolworths.com.au to claim and report trolley
# handoffs — it can do nothing else. Signed-in household members can read it
# (the web app builds the bookmarklet with it). Changing it means dragging the
# bookmark to the bookmarks bar again. (generate: openssl rand -hex 32)
STORE_TAB_SECRET=

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# AES-256 credential encryption key, base64-encoded 32 bytes
# (generate: openssl rand -base64 32)
CREDENTIAL_ENCRYPTION_KEY=

# CORS — comma-separated list of exact origins allowed to call the API.
# Never a wildcard: credentials are allowed on these requests.
CORS_ORIGINS=http://localhost:3000

# Log filter (tracing EnvFilter syntax), e.g. grocery_backend=debug
RUST_LOG=grocery_backend=info,tower_http=info,warn
# Log level for the Python Alexa bridge sidecar
LOG_LEVEL=INFO

# Frontend → backend URLs (defaults are correct for a same-machine setup)
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# Set to true only for local development without Clerk configured. It turns
# authentication off entirely and the backend logs a warning at startup.
# Never enable it on a deployment reachable from the Cloudflare Tunnel.
DEV_AUTH_BYPASS=false
DEV_AUTH_BYPASS=false

# Store product search (docs/features/FEATURE_STORE_INTEGRATION.md).
# live = the real Woolworths and Coles websites; fake = a small built-in
# catalogue for development and tests, which never contacts a store.
STORE_CLIENTS=live
# Seconds one store may take to answer a search.
STORE_TIMEOUT_SECONDS=12
# Seconds an identical search is answered from memory. Repeating the same
# request quickly is what the stores' bot protection flags.
STORE_SEARCH_CACHE_SECONDS=600
# Only for pointing a client at a mock server; leave unset normally.
# WOOLWORTHS_BASE_URL=https://www.woolworths.com.au
# COLES_BASE_URL=https://www.coles.com.au
