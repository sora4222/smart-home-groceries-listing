# PostgreSQL
POSTGRES_DB=grocery
POSTGRES_USER=grocery
POSTGRES_PASSWORD=changeme
# Host port Compose publishes Postgres on; the tests connect here. Change it
# if another Postgres already uses 5432 on this machine.
POSTGRES_PORT=5432
# Containers always reach the database on db:5432, whatever POSTGRES_PORT is.
# Note: a plain postgres:// URL — sqlx takes no driver suffix, unlike
# SQLAlchemy's postgresql+asyncpg://
DATABASE_URL=postgres://grocery:changeme@db:5432/grocery
DATABASE_MAX_CONNECTIONS=10

# Address the backend binds to inside its container
BIND_ADDRESS=0.0.0.0:8000

# Clerk
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Clerk JWKS endpoint, from your Clerk instance's API settings
CLERK_JWKS_URL=

# Generic intake webhook shared secret — Home Assistant, IFTTT, curl, tests
# (generate: openssl rand -hex 32)
VOICE_WEBHOOK_SECRET=

# Alexa
# Your skill id from the Alexa developer console (amzn1.ask.skill.<uuid>).
# The bridge verifies every request against it.
ALEXA_SKILL_ID=
# Secret the Alexa bridge sidecar authenticates to the backend with. Keep it
# DIFFERENT from VOICE_WEBHOOK_SECRET, so leaking one does not grant the other.
# (generate: openssl rand -hex 32)
ALEXA_BRIDGE_SECRET=

# LLM triage — "would a supermarket sell this?" for every intake item
# (docs/features/FEATURE_TRIAGE.md). Triage never accepts an item; it only
# decides whether a person sees it in Pending Requests or on the Triage page.
#   ollama   — a local Ollama server (free; the default)
#   llamacpp — llama.cpp's llama-server (free; light, runs on a CPU)
#   vllm     — a vLLM server (free; needs an NVIDIA GPU)
#   openai   — OpenAI's API in the cloud (paid; needs OPENAI_API_KEY)
#   fake     — a short keyword list, for development; nothing leaves the machine
#   off      — no triage: every item goes straight to Pending Requests
INTAKE_LLM_PROVIDER=ollama
# Starts the local model server Docker should run with the app: ollama,
# llamacpp or vllm (see docker-compose.yml). Leave empty if you run it yourself.
COMPOSE_PROFILES=ollama
# Where the model server answers. With the server from COMPOSE_PROFILES:
#   ollama   http://ollama:11434/v1
#   llamacpp http://llamacpp:8080/v1
#   vllm     http://vllm:8000/v1
# A server on the home server itself, outside Docker:
#   http://host.docker.internal:<port>/v1
INTAKE_LLM_BASE_URL=http://ollama:11434/v1
# Optional. Defaults: llama3.2 (ollama), local (llamacpp — it serves whatever
# model it started with), Qwen/Qwen2.5-1.5B-Instruct (vllm), gpt-4o-mini (openai).
INTAKE_LLM_MODEL=
# llama.cpp only: the Hugging Face model it downloads (repo:quantisation).
LLAMACPP_HF_MODEL=Qwen/Qwen2.5-1.5B-Instruct-GGUF:Q4_K_M
# Only if you started llama.cpp or vLLM with --api-key.
INTAKE_LLM_API_KEY=
# Only for INTAKE_LLM_PROVIDER=openai.
OPENAI_API_KEY=
# Answers less sure than this (0 to 1) are held for review.
INTAKE_LLM_MIN_CONFIDENCE=0.7
# How long the checker may take before the item is held for review. A local
# model on a CPU can be slow the first time it loads.
INTAKE_LLM_TIMEOUT_SECONDS=60

# Google Tasks intake (docs/features/FEATURE_GOOGLE_TASKS.md). Optional.
# From your Google Cloud project's OAuth client — docs/human-setup.md,
# "Optional: Google Tasks". The list to watch is chosen on /settings/intake.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where Google sends the browser back. Must match the OAuth client exactly.
GOOGLE_REDIRECT_URI=http://localhost:3000/settings/intake
# live = Google's real API; fake = an in-memory account for development and
# e2e tests, which never contacts Google.
GOOGLE_TASKS_CLIENT=live

# "Fill Woolworths trolley" bookmarklet secret (docs/FEAT_WOOLWORTHS_ACCESS.md).
# The bookmarklet sends it from woolworths.com.au to claim and report trolley
# handoffs — it can do nothing else. Signed-in household members can read it
# (the web app builds the bookmarklet with it). Changing it means dragging the
# bookmark to the bookmarks bar again. (generate: openssl rand -hex 32)
STORE_TAB_SECRET=

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# AES-256 credential encryption key, base64-encoded 32 bytes
# (generate: openssl rand -base64 32)
CREDENTIAL_ENCRYPTION_KEY=

# CORS — comma-separated list of exact origins allowed to call the API.
# Never a wildcard: credentials are allowed on these requests.
CORS_ORIGINS=http://localhost:3000

# Log filter (tracing EnvFilter syntax), e.g. grocery_backend=debug
RUST_LOG=grocery_backend=info,tower_http=info,warn
# Log level for the Python Alexa bridge sidecar
LOG_LEVEL=INFO

# Frontend → backend URLs (defaults are correct for a same-machine setup)
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# Set to true only for local development without Clerk configured. It turns
# authentication off entirely and the backend logs a warning at startup.
# Never enable it on a deployment reachable from the Cloudflare Tunnel.
DEV_AUTH_BYPASS=false
DEV_AUTH_BYPASS=false

# Store product search (docs/features/FEATURE_STORE_INTEGRATION.md).
# live = the real Woolworths and Coles websites; fake = a small built-in
# catalogue for development and tests, which never contacts a store.
STORE_CLIENTS=live
# Seconds one store may take to answer a search.
STORE_TIMEOUT_SECONDS=12
# Seconds an identical search is answered from memory. Repeating the same
# request quickly is what the stores' bot protection flags.
STORE_SEARCH_CACHE_SECONDS=600
# Only for pointing a client at a mock server; leave unset normally.
# WOOLWORTHS_BASE_URL=https://www.woolworths.com.au
# COLES_BASE_URL=https://www.coles.com.au
