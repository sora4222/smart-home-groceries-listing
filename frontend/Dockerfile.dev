# Vite development image. The build context includes shared configuration loaders.
FROM node:22-bookworm-slim
RUN npm install --global pnpm@10.28.0
RUN mkdir -p /workspace/frontend /workspace/scripts && chown -R node:node /workspace
WORKDIR /workspace/frontend
USER node
COPY --chown=node:node frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY --chown=node:node frontend/ ./
COPY --chown=node:node scripts/environment.mjs scripts/environment.d.mts \
  scripts/service-components.mjs scripts/service-components.d.mts /workspace/scripts/
CMD ["pnpm", "exec", "vite", "dev", "--host", "0.0.0.0", "--port", "3000", "--strictPort"]
